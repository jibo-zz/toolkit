# ==========================================
# Go-specific ignores
# ==========================================

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
*.prof
coverage.txt
coverage.html

# Compiled Object files, Static and Dynamic libs (Shared Objects)
*.o
*.a
*.cgo1.go
*.cgo2.c
_cgo_defun.c
_cgo_gotypes.go
_cgo_export.*
_testmain.go

# Standard output directories
_obj/
_test/
bin/
build/
dist/
out/

# Dependency directories (often ignored if relying entirely on go.mod)
vendor/

# Go workspace files (usually local only)
go.work
go.work.sum

# ==========================================
# Environment / Secrets
# ==========================================
.env
.env.local
*.pem

# ==========================================
# OS / IDE specific
# ==========================================

# macOS
.DS_Store

# Windows
Thumbs.db

# VS Code
.vscode/

# JetBrains / GoLand
.idea/
*.iml

# Vim
*.swp
*.swo

# Ignore all files inside any directory named 'uploads'
**/uploads/*

# Exception: Do not ignore the hidden .gitkeep file
!**/uploads/.gitkeep

test.jpeg